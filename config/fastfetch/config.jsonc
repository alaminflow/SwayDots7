{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "source": "arch",
    "color": {
      "1": "blue",
      "2": "cyan"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys":   "blue",
      "title":  "cyan",
      "output": "white"
    }
  },
  "modules": [
    {
      "type":   "title",
      "color":  { "user": "cyan", "at": "white", "host": "blue" }
    },
    "separator",
    { "type": "os",           "key": "  OS",      "keyColor": "blue" },
    { "type": "kernel",       "key": " 󰌽 Kernel",  "keyColor": "blue" },
    { "type": "wm",           "key": "  WM",      "keyColor": "blue" },
    { "type": "shell",        "key": "  Shell",   "keyColor": "blue" },
    { "type": "terminal",     "key": "  Term",    "keyColor": "blue" },
    "separator",
    { "type": "cpu",          "key": " 󰘚 CPU",     "keyColor": "mauve" },
    { "type": "gpu",          "key": "  GPU",      "keyColor": "mauve" },
    { "type": "memory",       "key": " 󰍛 Memory",  "keyColor": "mauve" },
    { "type": "disk",         "key": " 󰋊 Disk",    "keyColor": "mauve",
      "folders": "/" },
    { "type": "battery",      "key": "  Battery", "keyColor": "mauve" },
    "separator",
    { "type": "uptime",       "key": " 󱫐 Uptime",  "keyColor": "green" },
    { "type": "packages",     "key": " 󰏗 Packages", "keyColor": "green" },
    "separator",
    { "type": "colors",       "paddingLeft": 2, "symbol": "circle" }
  ]
}
