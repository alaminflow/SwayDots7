# =============================================================================
#  Dunst — Catppuccin Mocha
# =============================================================================
[global]
    monitor = 0
    follow = mouse

    width = 380
    height = 300
    origin = top-right
    offset = 12x50
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 5
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 2
    gap_size = 6
    separator_color = frame
    sort = yes

    font = JetBrainsMono Nerd Font 11
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_theme = Papirus-Dark, hicolor
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64

    sticky_history = yes
    history_length = 20

    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 10
    ignore_dbusclose = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

# ── Urgency levels ──────────────────────────────────────────────────────────
[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#313244"
    timeout = 5
    icon = dialog-information

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    frame_color = "#cba6f7"
    timeout = 8
    icon = dialog-information

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
    icon = dialog-error

# ── App-specific ─────────────────────────────────────────────────────────────
[volume]
    appname = "Volume"
    frame_color = "#94e2d5"

[brightness]
    appname = "Brightness"
    frame_color = "#f9e2af"

[battery]
    appname = "Battery"
    frame_color = "#a6e3a1"
    urgency = normal

[battery_critical]
    appname = "Battery"
    summary = "*low*"
    urgency = critical
