{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 4,
  "margin-top": 6,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": [
    "sway/workspaces",
    "sway/mode",
    "sway/scratchpad"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "bluetooth",
    "network",
    "battery",
    "cpu",
    "memory",
    "backlight",
    "tray",
    "custom/power"
  ],

  "sway/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "1": "󰎤",
      "2": "󰈹",
      "3": "󰨞",
      "4": "󱞁",
      "5": "󰙯",
      "urgent": "󰗖",
      "focused": "󰮯",
      "default": "󰊠"
    }
  },

  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },

  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", "󰃣"],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },

  "clock": {
    // Change to your timezone — run: timedatectl list-timezones | grep <region>
    "timezone": "Asia/Kolkata",
    "format": "󰥔  {:%H:%M}",
    "format-alt": "  {:%A, %B %d %Y}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "interval": 30
  },

  "cpu": {
    "format": "󰘚 {usage}%",
    "tooltip": false,
    "interval": 2,
    "on-click": "foot -e btop"
  },

  "memory": {
    "format": "󰍛 {used:.1f}G",
    "interval": 5,
    "on-click": "foot -e btop"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["󰂎","󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"],
    "interval": 60
  },

  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞","󰃟","󰃠"],
    "on-scroll-up":   "brightnessctl set 1%+",
    "on-scroll-down": "brightnessctl set 1%-"
  },

  "network": {
    "format-wifi":          "󰤨 {signalStrength}%",
    "format-ethernet":      "󰈀 Wired",
    "format-linked":        "󰈀 {ifname} (No IP)",
    "format-disconnected":  "󰤭 Disconnected",
    "format-alt":           "󰤨 {essid} | {ipaddr}",
    "tooltip-format":       "{ifname}: {ipaddr}/{cidr}\n{essid} ({signaldBm} dBm)",
    "on-click-right":       "nm-connection-editor",
    "interval": 30
  },

  "pulseaudio": {
    "format":         "{icon} {volume}%",
    "format-muted":   "󰝟 Muted",
    "format-icons": {
      "headphone":  "󰋋",
      "headset":    "󰋎",
      "portable":   "󰄞",
      "default":    ["󰕿","󰖀","󰕾"]
    },
    "on-click":       "pavucontrol",
    "on-scroll-up":   "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%-",
    // max-volume: raise to 150 for boost (risks audio clipping)
    "max-volume": 100,
    "scroll-step": 1
  },

  "bluetooth": {
    "format":           "󰂯",
    "format-connected": "󰂱 {device_alias}",
    "format-disabled":  "󰂲",
    "tooltip-format":   "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "blueman-manager"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "custom/power": {
    "format": "󰐥",
    "on-click": "wlogout",
    "tooltip": false
  }
}
