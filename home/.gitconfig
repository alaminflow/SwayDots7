[core]
    editor     = nvim
    pager      = delta
    autocrlf   = input
    fileMode   = true
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    default        = current
    autoSetupRemote = true

[fetch]
    prune = true

[merge]
    tool          = nvim
    conflictstyle = diff3

[diff]
    colorMoved = default

[rebase]
    autoStash   = true
    autosquash  = true

[status]
    showUntrackedFiles = all

[log]
    date = iso

# ── Delta pager ───────────────────────────────────────────────────────────────
[delta]
    navigate          = true
    light             = false
    side-by-side      = true
    line-numbers      = true
    syntax-theme      = Catppuccin-mocha

# ── Aliases ───────────────────────────────────────────────────────────────────
[alias]
    st     = status -sb
    lg     = log --oneline --graph --decorate --all
    lga    = log --oneline --graph --decorate --all --date=short --format='%C(auto)%h %C(cyan)%ad %C(auto)%s %C(dim white)(%an)%C(auto)%d'
    undo   = reset HEAD~1 --mixed
    amend  = commit --amend --no-edit
    unstage = reset HEAD --
    aliases = config --get-regexp alias
    branches = branch -a
    remotes  = remote -v
    tags     = tag -l
    stashes  = stash list
    whoami   = config user.email

# ── Colour ────────────────────────────────────────────────────────────────────
[color]
    ui     = auto
    branch = auto
    diff   = auto
    status = auto

[color "branch"]
    current = yellow reverse
    local   = yellow
    remote  = green

[color "diff"]
    meta = yellow
    frag = magenta bold
    old  = red bold
    new  = green bold

# ── URL shortcuts ─────────────────────────────────────────────────────────────
[url "git@github.com:"]
    insteadOf = gh:
[url "git@gitlab.com:"]
    insteadOf = gl:

# ── User (fill in after install) ──────────────────────────────────────────────
# Run: git config --global user.name "Your Name"
#      git config --global user.email "you@example.com"
